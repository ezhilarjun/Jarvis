# Copy this file to ".env" (same folder) and edit.
# Microphone: index or part of the name. List devices with:
#   py -3.12 -c "import sounddevice as sd; print(sd.query_devices())"
JARVIS_INPUT_DEVICE=0

# Ollama model name exactly as shown by `ollama list`
OLLAMA_MODEL=llama3.2:3b

# Speech recognition device: cpu (default, always works) or cuda (NVIDIA GPU only)
JARVIS_WHISPER_DEVICE=cpu
# Whisper size: tiny (fastest) | base | small (most accurate)
WHISPER_MODEL=base

# HUD hides itself after this many seconds of inactivity (0 = never hide)
JARVIS_HUD_HIDE_SECONDS=60
